---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="mb-6 sm:mb-8">
  <h1
    class="m-0 text-3xl font-semibold leading-tight tracking-[-0.025em] text-foreground [overflow-wrap:anywhere] [text-wrap:balance]"
  >
    {title}
  </h1>
  {
    Astro.slots.has("default") && (
      <div class="mt-2.5 flex items-baseline gap-3 font-mono text-meta text-muted-foreground">
        <span class="shrink-0 text-primary" aria-hidden="true">
          ::
        </span>
        <div class="min-w-0">
          <slot />
        </div>
      </div>
    )
  }
</header>
